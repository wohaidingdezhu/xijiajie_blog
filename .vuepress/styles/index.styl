// 与 fe-interview 共用的视觉基准。组件样式集中于此，避免多层覆盖。
:root, :root.light, :root.dark {
  color-scheme: light;
  --background-color: #fff !important;
  --text-color: #293b36 !important;
  --text-color-sub: #718078 !important;
  --border-color: #e7ece9 !important;
  --code-color: #f0f3ee !important;
  --box-shadow: none !important;
  --box-shadow-hover: none !important;
  --blog-accent: #26765e;
  --blog-heading: #233c2e;
  --blog-surface: #fafbf9;
  --blog-field: #f7f9f7;
  --blog-selected: #e6efe7;
  --blog-muted: #718078;
  --blog-line: #e7ece9;
  --blog-header: 80px;
  --blog-side: 264px;
}
html { scroll-padding-top: 104px; scrollbar-gutter: stable; }
html body {
  margin: 0;
  background: #fff;
  color: #293b36;
  font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
}
.blog-app { min-height: 100vh; }
.blog-workspace[inert], .blog-search[inert] { pointer-events: none; user-select: none; }
.blog-app *, .blog-app *:before, .blog-app *:after { box-sizing: border-box; }
.blog-app a { color: inherit; text-decoration: none; font-weight: inherit; }
.blog-app button, .blog-app input { font: inherit; }
.blog-app button { cursor: pointer; color: inherit; }
.blog-app a, .blog-app button { touch-action: manipulation; }
.blog-app a:focus-visible, .blog-app button:focus-visible, .blog-app input:focus-visible,
.blog-app summary:focus-visible, .blog-app pre:focus-visible { outline: 3px solid #90cbb4; outline-offset: 4px; }
.blog-app h1 { display: block; font-size: 34px; line-height: 1.35; letter-spacing: -.8px; font-weight: 650; color: var(--blog-heading); margin: 16px 0; }
.blog-app h2 { padding: 0; }
.blog-app h2:before { display: none; }
.blog-app p { line-height: 1.8; }
::selection { background: #d9eee2; }
.blog-app .skip-link { position: fixed; top: -100px; left: 20px; padding: 12px; background: #fff; z-index: 100; }
.blog-app .skip-link:focus { top: 8px; }

// 站点顶栏：品牌、搜索、站点入口。
.blog-header { position: fixed; inset: 0 0 auto; height: var(--blog-header); z-index: 30; display: flex; align-items: center; gap: 48px; padding: 0 32px; background: #ffffffed; backdrop-filter: blur(12px); border-bottom: 1px solid var(--blog-line); }
.blog-brand { display: flex; align-items: center; gap: 12px; min-width: 216px; flex-shrink: 0; font-size: 19px; font-weight: 700 !important; letter-spacing: -.4px; }
.blog-brand small { display: block; margin-top: 3px; font-size: 10px; font-weight: 400; letter-spacing: 2px; color: var(--blog-muted); }
.brand-icon { display: grid; place-items: center; width: 37px; height: 37px; border-radius: 10px; background: var(--blog-accent); color: #fff; font: 600 17px/1 monospace; }
.blog-search { position: relative; width: unquote('min(430px, 40vw)'); min-width: 0; }
.blog-search input { width: 100%; height: 40px; padding: 0 100px 0 35px; border: 1px solid #e8ece9; border-radius: 7px; background: var(--blog-field); color: #314b40; font-size: 12px; }
.blog-search input:focus { border-color: #83b09a; }
.blog-search input::-webkit-search-cancel-button { -webkit-appearance: none; }
.blog-search .search-clear { position: absolute; top: 6px; right: 50px; display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; border-radius: 4px; background: transparent; color: var(--blog-muted); font-size: 19px; }
.blog-search .search-clear:hover { background: var(--blog-selected); color: var(--blog-accent); }
.blog-search svg { position: absolute; top: 12px; left: 12px; width: 16px; height: 16px; stroke: #7e8b83; stroke-width: 1.8; fill: none; pointer-events: none; }
.blog-search kbd { position: absolute; top: 13px; right: 52px; color: #718078; font: 10px/1.4 monospace; background: none; padding: 0; border: 0; pointer-events: none; }
.blog-search .search-submit { position: absolute; inset: 4px 4px 4px auto; padding: 0 8px; border: 0; border-radius: 4px; background: transparent; font-size: 11px; color: var(--blog-accent); }
.blog-search .search-submit:hover { background: var(--blog-selected); }
.header-nav { display: flex; align-items: center; gap: 24px; margin-left: auto; white-space: nowrap; font-size: 12px; color: var(--blog-muted); }
.header-nav a { padding: 12px 0; }
.header-nav .active, .header-nav a:hover { color: var(--blog-accent); }
.header-nav .active { font-weight: 600; }
.header-nav span { font-size: 11px; }
.menu-button, .mobile-site-nav, .menu-overlay { display: none; }

// 所有页面保持相同的左侧分类导航。
.blog-sidebar { position: fixed; top: var(--blog-header); bottom: 0; left: 0; width: var(--blog-side); border-right: 1px solid var(--blog-line); background: var(--blog-surface); padding: 31px 22px 24px; overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; z-index: 25; }
.sidebar-label { display: flex; justify-content: space-between; align-items: center; margin: 0 10px 32px; font-size: 11px; letter-spacing: 1.5px; color: var(--blog-muted); }
.sidebar-label > span:last-child { font-size: 10px; letter-spacing: 0; padding: 3px 6px; border: 1px solid var(--blog-line); border-radius: 4px; }
.sidebar-section-label { margin: 0 10px 12px; font-size: 11px; color: var(--blog-muted); }
.category-nav { margin-bottom: 28px; }
.blog-sidebar .category-link { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 42px; padding: 10px 12px 10px 32px; margin-bottom: 4px; border-radius: 5px; font-size: 12px; color: #66796e; }
.blog-sidebar .category-link.active { color: #236849; background: var(--blog-selected); font-weight: 600; }
.category-link.active:before { content: ''; position: absolute; width: 5px; height: 5px; left: 13px; top: 19px; border-radius: 50%; background: #39815d; }
.category-link span { font-size: 10px; font-weight: 400; }
.blog-sidebar a:hover { color: var(--blog-accent); background: #edf2ed; }
.related-nav { border-top: 1px solid var(--blog-line); padding-top: 22px; margin-bottom: 28px; }
.related-nav a { display: block; border-radius: 5px; margin: 3px 0; padding: 10px; color: var(--blog-muted); font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }
.related-nav a.active { background: var(--blog-selected); color: var(--blog-accent); }
.sidebar-footer { margin-top: auto; border-top: 1px solid var(--blog-line); padding: 20px 10px 0; color: var(--blog-muted); font-size: 11px; }
.sidebar-footer p { margin: 0 0 12px; }
.sidebar-footer small { display: block; margin-top: 4px; font-size: 10px; }
.sidebar-footer a { display: inline-block; padding: 5px 0; }

// 列表与归档使用同一条内容起始线。
.blog-workspace { margin-left: var(--blog-side); padding: 114px 44px 0 58px; display: grid; grid-template-columns: minmax(0, 1000px); justify-content: center; }
.blog-workspace.is-article { grid-template-columns: minmax(0, 760px) 170px; column-gap: 55px; }
.blog-workspace main { min-width: 0; outline: none; }
.blog-app .breadcrumb { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; color: var(--blog-muted); font-size: 11px; line-height: 1.7; margin-bottom: 32px; }
.breadcrumb a:hover { color: var(--blog-accent); }
.breadcrumb > span[aria-hidden] { color: #aab7ae; }
.collection-heading { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-bottom: 36px; }
.blog-app .eyebrow { font-size: 10px; letter-spacing: 1.8px; color: var(--blog-muted); margin: 0 0 8px; }
.blog-app .description { color: var(--blog-muted); font-size: 13px; line-height: 1.9; margin: 0; }
.collection-count { flex-shrink: 0; text-align: right; color: #71836f; margin: 28px 0 0; }
.collection-count strong { display: block; font-size: 30px; line-height: 1.3; font-weight: 400; }
.collection-count span { display: block; font-size: 11px; margin-top: 8px; }
.list-summary { display: flex; justify-content: space-between; gap: 12px; color: var(--blog-muted); font-size: 11px; padding-bottom: 14px; border-bottom: 1px solid var(--blog-line); }
.article-row { padding: 24px 0; border-bottom: 1px solid var(--blog-line); }
.article-row-meta { display: flex; align-items: center; gap: 16px; font-size: 11px; color: var(--blog-muted); }
.article-row-meta time { margin-left: auto; }
.blog-app .article-row h2 { font-size: 19px; font-weight: 600; color: #314a38; margin: 12px 0 8px; line-height: 1.6; }
.article-row h2 a:hover { color: var(--blog-accent); }
.article-row h2 span[aria-hidden] { display: inline-block; margin-left: 12px; color: #8fa58f; font-size: 14px; }
.blog-app .article-summary { color: var(--blog-muted); font-size: 13px; line-height: 1.8; margin: 0 0 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.blog-app .article-summary.search-snippet { white-space: normal; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
.article-row mark { color: var(--blog-accent); background: var(--blog-selected); border-radius: 2px; padding: 0 2px; }
.search-status { color: var(--blog-muted); font-size: 13px; margin: 24px 0; }
.search-status button { margin-left: 8px; border: 0; background: transparent; color: var(--blog-accent); text-decoration: underline; }
.article-tags { display: flex; flex-wrap: wrap; gap: 7px; }
.article-tags a { padding: 3px 8px; background: #f6f8f3; border: 1px solid var(--blog-line); border-radius: 4px; font-size: 10px; line-height: 1.6; color: #65785f; }
.article-tags a:hover { border-color: #adc5b3; color: var(--blog-accent); }
.filter-status { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; background: var(--blog-field); padding: 14px 16px; margin-bottom: 24px; border-radius: 6px; font-size: 13px; overflow-wrap: anywhere; }
.filter-status a, .empty-state a { color: var(--blog-accent); }
.list-pagination { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin: 28px 0 36px; font-size: 12px; color: var(--blog-muted); }
.list-pagination a, .list-pagination .disabled { padding: 9px 13px; border: 1px solid var(--blog-line); border-radius: 5px; background: var(--blog-surface); }
.list-pagination a { color: var(--blog-accent); }
.list-pagination .disabled { opacity: .45; }
.archive-list section { margin-bottom: 36px; }
.blog-app .archive-list h2 { display: flex; align-items: baseline; gap: 12px; font-size: 24px; font-weight: 600; margin: 26px 0 12px; color: var(--blog-heading); }
.archive-list h2 span { color: var(--blog-muted); font-size: 11px; font-weight: 400; }
.archive-row { display: flex; align-items: baseline; gap: 24px; padding: 18px 0; border-bottom: 1px solid var(--blog-line); font-size: 14px; line-height: 1.7; }
.archive-row time { width: 40px; flex-shrink: 0; font-size: 11px; color: var(--blog-muted); }
.archive-row > span:last-child { margin-left: auto; color: #8fa58f; }
.archive-row:hover { color: var(--blog-accent); }
.empty-state { text-align: center; padding: 64px 0; min-height: 50vh; }
.empty-state p { color: var(--blog-muted); }
.blog-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 14px; border-top: 1px solid var(--blog-line); margin-top: 44px; padding: 24px 0 30px; font-size: 11px; color: var(--blog-muted); }
.blog-footer a:hover { color: var(--blog-accent); }

// 阅读区域：正文与辅助信息分别控制密度。
.article-heading { margin-bottom: 32px; }
.article-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; font-size: 11px; color: var(--blog-muted); }
.content-type { background: #f3f8f0; border: 1px solid #dfeadf; border-radius: 4px; padding: 4px 8px; color: #657e59; }
.article-heading .description { margin-bottom: 22px; }
.reading-guide { border-block: 1px solid var(--blog-line); padding: 18px 0; margin: 0 0 28px; font-size: 13px; }
.reading-guide p { color: var(--blog-muted); font-size: 12px; margin: 0 0 12px; }
.reading-guide ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 32px; margin: 0; padding-left: 22px; }
.reading-guide a { color: var(--blog-accent); line-height: 1.7; }
.blog-app .article-body.content__default { padding: 0; margin: 0; max-width: none; font-size: 14px; line-height: 1.95; color: #506157; overflow-wrap: anywhere; }
.blog-app .article-body p { margin: 16px 0; line-height: 1.95; }
.blog-app .article-body h1, .blog-app .article-body h2 { font-size: 21px; font-weight: 600; color: #2f4435; margin: 36px 0 18px; padding: 0 0 12px; border-bottom: 1px solid var(--blog-line); letter-spacing: -.3px; }
.blog-app .article-body h3 { font-size: 16px; color: #334d3b; margin: 28px 0 12px; padding: 0; }
.blog-app .article-body h4, .blog-app .article-body h5, .blog-app .article-body h6 { font-size: 15px; margin: 24px 0 12px; padding: 0; }
.blog-app .article-body :is(h1,h2,h3,h4,h5,h6):first-child { margin-top: 0; }
.article-body ul, .article-body ol { padding-left: 24px; line-height: 1.95; }
.article-body li { margin: 6px 0; }
.article-body li::marker { color: #849e8a; }
.article-body strong { color: #334d3b; font-weight: 600; }
.blog-app .article-body a { color: var(--blog-accent); text-decoration: underline; text-decoration-color: #c4dacb; text-underline-offset: 4px; }
.blog-app .article-body a.header-anchor { float: left; margin-left: -1em; width: 1em; text-decoration: none; opacity: 0; font-size: .85em; }
.article-body :is(h1,h2,h3,h4,h5,h6):hover a.header-anchor, .article-body a.header-anchor:focus { opacity: 1; }
.blog-app .article-body blockquote { margin: 24px 0; border-left: 3px solid #81a573; background: #f5f8f0; border-radius: 0 6px 6px 0; padding: 12px 20px; color: #617453; font-size: 14px; }
.blog-app .article-body blockquote p { margin: 5px 0; }
.blog-app .article-body :not(pre) > code { background: #f0f3ee; color: #507345; border: 1px solid #e8eee4; border-radius: 4px; padding: 2px 5px; font-size: .88em; }
.article-body img { max-width: 100%; height: auto; }
.article-body table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: 24px 0; font-size: 14px; }
.article-body th, .article-body td { border: 1px solid var(--blog-line); padding: 11px 16px; text-align: left; }
.article-body th { background: #f6f8f3; font-weight: 600; }
.article-body tr:nth-child(2n) { background: var(--blog-surface); }
.article-body hr { border: 0; border-top: 1px solid var(--blog-line); margin: 28px 0; }
.article-updated { display: flex; flex-wrap: wrap; gap: 12px; color: var(--blog-muted); font-size: 11px; margin-top: 40px; }
.article-updated a { margin-left: auto; color: var(--blog-accent); }
.article-pagination { display: flex; justify-content: space-between; gap: 24px; border-top: 1px solid var(--blog-line); margin-top: 24px; padding-top: 24px; font-size: 13px; }
.article-pagination > div { flex: 1; min-width: 0; }
.article-pagination > div:last-child { text-align: right; }
.article-pagination small { display: block; color: var(--blog-muted); font-size: 11px; margin-bottom: 10px; }
.article-pagination a { color: var(--blog-accent); line-height: 1.7; }
.article-toc { align-self: start; position: sticky; top: 114px; max-height: calc(100vh - 140px); display: flex; flex-direction: column; min-height: 0; font-size: 12px; }
.toc-toggle { display: flex; justify-content: space-between; align-items: center; gap: 10px; width: 100%; min-height: 36px; padding: 0 0 12px; border: 0; background: transparent; text-align: left; font-size: 12px !important; color: #405b47; }
.toc-toggle span { font-size: 10px; color: var(--blog-muted); }
.article-toc nav { overflow-y: auto; overscroll-behavior: contain; padding: 3px 4px 3px 0; }
.article-toc a { display: block; padding: 7px 0 7px 14px; border-left: 1px solid var(--blog-line); color: var(--blog-muted); line-height: 1.7; overflow-wrap: anywhere; }
.article-toc a.toc-sub { padding-left: 24px; font-size: 11px; }
.article-toc a.active, .article-toc a:hover { color: var(--blog-accent); border-color: var(--blog-accent); }

// 代码块沿用资料库的墨绿底色和语法色。
.blog-app .article-body div[class*='language-'] { position: relative; max-width: 100%; background: #202d29; border-radius: 8px; margin: 22px 0; }
.blog-app .article-body pre, .blog-app .article-body pre[class*='language-'] { position: relative; overflow-x: auto; margin: 0; padding: 42px 22px 22px; background: #202d29; border-radius: 8px; font-size: 13px; line-height: 1.85; tab-size: 2; }
.blog-app .article-body pre code { padding: 0; background: transparent; color: #dce7e0; font-size: inherit; border: 0; white-space: pre; }
.blog-app code, .blog-app pre { font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace; text-shadow: none; }
.blog-app .article-body div[class*='language-']:before { position: absolute; top: 13px; left: 22px; color: #9cbda0; font: 11px/1.4 monospace; z-index: 2; }
.blog-app div.language-js:before { content: 'JavaScript'; }
.blog-app div.language-javascript:before { content: 'JavaScript'; }
.blog-app div.language-ts:before, .blog-app div.language-typescript:before { content: 'TypeScript'; }
.blog-app div.language-html:before { content: 'HTML'; }
.blog-app div.language-css:before { content: 'CSS'; }
.blog-app div.language-sh:before, .blog-app div.language-bash:before { content: 'Shell'; }
.blog-app div.language-json:before { content: 'JSON'; }
.blog-app .line-numbers-wrapper { display: none; }
.blog-app .highlight-lines { position: absolute; top: 42px; width: 100%; pointer-events: none; line-height: 1.85; font-size: 13px; }
.blog-app .highlighted { background: #ffffff10; }
.blog-app .token { background: transparent; text-shadow: none; }
.blog-app .token.comment, .blog-app .token.prolog, .blog-app .token.doctype, .blog-app .token.cdata, .blog-app .token.string, .blog-app .token.char, .blog-app .token.attr-value, .blog-app .token.inserted { color: #9cbda0; }
.blog-app .token.keyword, .blog-app .token.boolean, .blog-app .token.atrule { color: #c5b5ed; }
.blog-app .token.number, .blog-app .token.constant, .blog-app .token.symbol, .blog-app .token.attr-name, .blog-app .token.regex, .blog-app .token.variable { color: #e4be8f; }
.blog-app .token.function, .blog-app .token.class-name, .blog-app .token.tag, .blog-app .token.property { color: #94c8d2; }
.blog-app .token.operator, .blog-app .token.entity, .blog-app .token.url { color: #dbdfc6; }
.blog-app .token.punctuation { color: #dce7e0; }
.blog-app .token.deleted, .blog-app .token.important { color: #f39b8f; }
.blog-app .code-copy-button { position: absolute; z-index: 2; top: 8px; right: 10px; padding: 5px 8px; border: 1px solid #48594f; border-radius: 4px; background: #35473e; color: #bccfc1; font-size: 11px; line-height: 1.4; }
.blog-app .code-copy-button:hover { color: #fff; }
.blog-app .custom-block { padding: 12px 20px; border-left: 3px solid #81a573; background: #f5f8f0; margin: 20px 0; border-radius: 0 6px 6px 0; }
.blog-app .custom-block.warning { border-color: #b19756; background: #fbf8ee; }
.blog-app .custom-block.danger { border-color: #b96c62; background: #fff5f3; }

@media (min-width: 1500px) {
  .blog-workspace { padding-left: 80px; padding-right: 80px; }
}
@media (max-width: 1150px) {
  .blog-header { gap: 28px; }
  .blog-brand { min-width: 204px; }
  .header-nav { gap: 16px; }
  .blog-workspace, .blog-workspace.is-article { grid-template-columns: minmax(0, 760px); padding-left: 36px; padding-right: 36px; }
  .blog-workspace.is-article { padding-bottom: 80px; }
  .article-toc { position: fixed; z-index: 20; right: 24px; bottom: 20px; top: auto; width: unquote('min(360px, calc(100vw - var(--blog-side) - 48px))'); max-height: 60vh; max-height: 60dvh; margin: 0; padding: 10px 16px; border: 1px solid #d8e5dd; border-radius: 8px; background: #fff; box-shadow: 0 8px 32px #1d3e2512; }
  .toc-toggle { padding: 0; min-height: 32px; }
  .article-toc.is-expanded .toc-toggle { margin-bottom: 10px; }
}
@media (max-width: 760px) {
  :root, :root.light, :root.dark { --blog-header: 68px; --blog-side: 250px; }
  html { scroll-padding-top: 88px; }
  body.blog-menu-open { overflow: hidden; }
  .blog-header { gap: 12px; padding: 0 17px; }
  .blog-brand { min-width: 0; gap: 8px; font-size: 15px; }
  .blog-brand small { font-size: 8px; letter-spacing: 1px; }
  .brand-icon { width: 30px; height: 30px; font-size: 14px; border-radius: 8px; }
  .blog-search { flex: 1; width: auto; }
  .blog-search input { padding: 0 66px 0 28px; font-size: 12px; }
  .blog-search .search-clear { right: 36px; }
  .blog-search svg { left: 9px; width: 13px; }
  .blog-search kbd, .header-nav { display: none; }
  .blog-search .search-submit { padding: 0 4px; font-size: 10px; }
  .menu-button { display: block; flex-shrink: 0; min-height: 40px; padding: 0 9px; border: 1px solid var(--blog-line); border-radius: 5px; background: transparent; font-size: 11px !important; }
  .blog-sidebar { visibility: hidden; transform: translateX(-100%); transition: transform .18s; padding: 24px 20px; }
  .blog-sidebar.is-open { visibility: visible; transform: translateX(0); }
  .mobile-site-nav { display: grid; gap: 4px; padding-bottom: 20px; margin-bottom: 22px; border-bottom: 1px solid var(--blog-line); }
  .mobile-site-nav a { display: block; padding: 10px; font-size: 13px; }
  .menu-overlay { display: block; position: fixed; z-index: 24; inset: var(--blog-header) 0 0; border: 0; background: #18332838; }
  .blog-workspace, .blog-workspace.is-article { margin-left: 0; padding: 92px 23px 0; display: block; }
  .blog-workspace.is-article { padding-bottom: 80px; }
  .blog-app h1 { font-size: 29px; }
  .blog-app .breadcrumb { font-size: 10px; margin-bottom: 26px; }
  .collection-heading { gap: 16px; margin-bottom: 28px; }
  .collection-count strong { font-size: 26px; }
  .collection-count span { font-size: 10px; }
  .blog-app .description { font-size: 12px; }
  .blog-app .article-row h2 { font-size: 18px; }
  .blog-app .article-summary { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 12px; }
  .reading-guide ol { grid-template-columns: 1fr; }
  .article-tags a { padding: 6px 9px; min-height: 30px; }
  .article-heading { margin-bottom: 28px; }
  .article-meta { gap: 8px; font-size: 10px; }
  .article-toc { left: 16px; right: 16px; bottom: unquote('max(12px, env(safe-area-inset-bottom))'); width: auto; }
  .article-toc a { padding-top: 10px; padding-bottom: 10px; }
  .blog-app .article-body.content__default { font-size: 16px; }
  .blog-app .article-body h2 { font-size: 21px; }
  .blog-app .article-body h3 { font-size: 18px; }
  .blog-app .article-body pre, .blog-app .article-body pre[class*='language-'] { font-size: 12px; padding-left: 16px; padding-right: 16px; }
  .archive-row { gap: 16px; font-size: 13px; }
  .blog-footer { font-size: 10px; }
}
@media (max-width: 380px) {
  .blog-header { padding: 0 12px; gap: 8px; }
  .brand-icon { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .blog-app *, .blog-app *:before, .blog-app *:after { animation: none !important; transition: none !important; }
}

html::-webkit-scrollbar-thumb:vertical,
html::-webkit-scrollbar-thumb:horizontal,
body::-webkit-scrollbar-thumb:vertical,
body::-webkit-scrollbar-thumb:horizontal,
.blog-app ::-webkit-scrollbar-thumb:vertical,
.blog-app ::-webkit-scrollbar-thumb:horizontal { background: #ccd6ce; border-radius: 4px; }
.blog-app pre::-webkit-scrollbar-thumb:horizontal { background: #687a70; }
